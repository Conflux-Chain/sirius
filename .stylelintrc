{
  "extends": "stylelint-config-recommended",
  "ignoreFiles": ["src/styles/antd.custom.css"],
  "rules": {
    "value-no-vendor-prefix": true,
    "property-no-vendor-prefix": true,
    "no-empty-source": null
  },
  "overrides": [
    {
      "files": ["**/*.{js,jsx,ts,tsx}"],
      "customSyntax": "postcss-styled-syntax"
    }
  ]
}
