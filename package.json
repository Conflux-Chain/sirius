    "@types/react-test-renderer": "16.9.2",
    "@types/webpack-env": "1.15.1",
    "@web3identity/cns-util": "0.1.28",
    "@zeit-ui/react-icons": "1.3.1",
    "ace-builds": "1.4.12",
    "ace-mode-solidity": "0.1.1",
    "bignumber.js": "9.0.1",
    "buffer": "6.0.3",
    "clsx": "1.1.1",
    "conflux-sponsorfaucet": "1.1.5",
    "core-js": "3.22.5",
    "cross-env": "7.0.2",
    "crypto-browserify": "3.12.1",
    "d3-array": "2.8.0",
    "d3-scale": "3.2.3",
    "eslint-config-prettier": "8.10.0",
    "eslint-plugin-prettier": "3.1.2",
    "fontfaceobserver": "2.1.0",
    "highcharts": "11.4.9",
    "highcharts-react-official": "3.1.0",
    "husky": "4.3.8",
    "i18next": "19.3.4",
    "i18next-browser-languagedetector": "4.0.2",
    "jest-styled-components": "7.4.1",
    "js-conflux-sdk": "2.5.1",
    "json-bigint": "1.0.0",
    "lint-staged": "10.0.8",
    "lodash": "4.18.1",
    "md5.js": "1.3.5",
    "node-plop": "0.32.3",
    "numeral": "2.0.6",
    "pako": "2.0.2",
    "plop": "4.0.5",
    "prettier": "2.0.1",
    "process": "0.11.10",
    "qrcode.react": "1.0.0",
    "query-string": "10.0.0",
    "react": "18.2.0",
    "react-ace": "9.1.3",
    "react-app-polyfill": "3.0.0",
    "react-component-benchmark": "1.0.0",
    "react-dom": "18.2.0",
    "react-google-recaptcha": "2.1.0",
    "react-helmet-async": "1.0.6",
    "react-i18next": "11.18.6",
    "react-json-pretty": "2.2.0",
    "react-router-dom": "5.1.2",
    "react-scripts": "5.0.1",
    "react-test-renderer": "16.13.0",
    "react-use": "17.6.1",
    "recoil": "0.0.10",
    "sanitize.css": "11.0.0",
    "serve": "14.2.8",
    "shelljs": "0.8.5",
    "stream-browserify": "3.0.0",
    "styled-components": "6.4.3",
    "swr": "2.2.5",
    "vm-browserify": "1.1.2",
    "webfontloader": "1.6.28",
    "zustand": "4.1.4"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "start:base": "react-app-rewired start",
    "start:static": "REACT_APP_STATIC=true yarn start:base",
    "start:core": "REACT_APP_CORE_MAINNET=true yarn start:base",
    "start:core-testnet": "REACT_APP_CORE_TESTNET=true yarn start:base",
    "start:core-devnet": "REACT_APP_CORE_DEVNET=true yarn start:base",
    "build:base": "react-app-rewired build",
    "build:dev": "REACT_APP_DEV=true yarn build:base",
    "build:static": "REACT_APP_STATIC=true yarn build:base",
    "build:prod": "yarn build:base",
    "build": "yarn build:base",
    "test": "react-app-rewired test",
    "eject": "react-scripts eject",
    "checkTs": "tsc --noEmit",
    "eslint": "eslint --ext js,ts,tsx",
    "lint": "yarn eslint -- src",
    "prettify": "prettier --write"
  },
  "browserslist": [
    ">0.2%",
    "not ie <= 99",
    "not android <= 4.4.4",
    "not dead",
    "not op_mini all"
  ],
  "engines": {
    "npm": ">=8.6.0",
    "node": ">=22.12.0 <23"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "npm run eslint -- --fix"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run checkTs && lint-staged",
      "prepare-commit-msg": "exec < /dev/tty && git cz --hook || true"
    }
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*/*.d.ts",
      "!src/**/*/Loadable.{js,jsx,ts,tsx}",
      "!src/**/*/loadable.{js,jsx,ts,tsx}",
      "!src/**/*/types.ts",
      "!src/index.tsx",
      "!src/serviceWorker.ts",
      "!src/setupProxy.js"
    ],
    "moduleNameMapper": {
      "ace-builds": "<rootDir>/node_modules/ace-builds"
    }
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ],
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "master",
      {
        "name": "dev",
        "channel": "alpha",
        "prerelease": "alpha"
      }
    ]
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.14",
    "@testing-library/user-event": "12.1.6",
    "@types/lodash": "4.17.0",
    "babel-loader": "8.4.1",
    "cz-conventional-changelog": "3.3.0",
    "http-proxy-middleware": "1.0.5",
    "jest-fetch-mock": "3.0.3",
    "patch-package": "8.0.1",
    "postcss": "8.5.33",
    "postcss-styled-syntax": "0.7.4",
    "postinstall-postinstall": "2.1.0",
    "react-app-rewired": "2.2.1",
    "semantic-release": "24.2.9",
    "speed-measure-webpack-plugin": "1.5.0",
    "stylelint": "16.26.1",
    "stylelint-config-recommended": "17.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.4.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "resolutions": {
    "react-scripts/resolve-url-loader": "5.0.0",
    "**/viem/ws": "8.23.0",
    "**/@ethersproject/providers/ws": "8.23.0",
    "**/jsonpath/underscore": "1.13.8",
    "**/styled-jsx/loader-utils": "1.4.2",
    "@types/react": "18.2.58",
    "@types/react-dom": "18.2.19",
    "@walletconnect/sign-client": "2.26.0",
    "lodash": "4.18.1"
  }
}
